          "type": "integer",
          "minimum": 0,
          "maximum": 99998
        },
        "alwaysUseSameSeed": {
          "type": "boolean"
        },
        "mapSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255,
          "not": {
            "multipleOf": 2
          }
        },
        "localizations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/landscapeLocalization"
          },
          "contains": {
            "properties": {
              "language": {
                "const": "en-US"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "language",
              "name"
            ]
          }
        }
      }
    },
    "landscapeLocalization": {
      "type": "object",
      "additionalProperties": false,
