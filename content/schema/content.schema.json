    "aiProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "modules"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/namespacedId"
        },
        "assetBundleId": {
          "$ref": "#/$defs/namespacedId"
        },
        "prefabAssetName": {
          "type": "string",
          "pattern": "^RCL_[A-Za-z0-9_]{1,92}$"
        },
        "nativeTemplateId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scopeToReferencedStages": {
          "type": "boolean"
        },
        "unitDependencies": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/namespacedId"
          }
        },
        "unitEntries": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/aiUnitEntry"
          }
        },
        "productionBuildingEntries": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/aiProductionBuildingEntry"
          }
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/aiModule"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "nativeTemplateId"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "assetBundleId"
                ]
              },
              {
                "required": [
                  "prefabAssetName"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "assetBundleId",
            "prefabAssetName"
          ],
          "not": {
            "required": [
              "nativeTemplateId"
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "nativeTemplateId"
            ]
          },
          "then": {
            "required": [
              "scopeToReferencedStages"
            ],
            "properties": {
              "scopeToReferencedStages": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "scopeToReferencedStages"
            ],
            "properties": {
              "scopeToReferencedStages": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "nativeTemplateId"
            ]
          }
        }
      ]
    },
